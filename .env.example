# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=<choose-a-strong-password>
MONGO_DATABASE_NAME=SmartMicrogridDb

JWT_SECRET=<a-long-random-secret-at-least-32-characters>
JWT_ISSUER=SmartMicrogridApi
JWT_AUDIENCE=SmartMicrogridClients
JWT_EXPIRY_MINUTES=120

# Signs the QR transaction tokens. The API refuses to start without it.
QR_HMAC_SECRET=<a-long-random-secret-at-least-32-characters>

# The first Backoffice account, created on API startup only if no Backoffice user exists yet
SEED_ADMIN_EMAIL=admin@solargridx.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FULL_NAME=System Administrator

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=<your-gmail-address>
EMAIL_PASS=<a-gmail-app-password>

# Origin the browser serves the web app from — must match the web container's published port
WEB_ORIGIN=http://localhost:5173

# Base URL the web app calls — must match the api container's published port
# (baked into the web build at build time, not read at container runtime)
VITE_API_BASE_URL=http://localhost:5000/api
