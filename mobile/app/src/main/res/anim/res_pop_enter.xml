<?xml version="1.0" encoding="utf-8"?>
<!-- Shared axis X, back: previous screen returns from the left. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate android:fromXDelta="-8%" android:toXDelta="0%" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:startOffset="60" android:duration="240" />
</set>
