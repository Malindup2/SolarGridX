<?xml version="1.0" encoding="utf-8"?>
<!-- Shared axis X, back: current screen slides right and fades out. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="300"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate android:fromXDelta="0%" android:toXDelta="8%" />
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="120" />
</set>
