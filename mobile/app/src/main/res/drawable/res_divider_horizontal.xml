<?xml version="1.0" encoding="utf-8"?>
<!-- Hairline between rows inside a card, inset from the left edge. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="64dp">
    <shape android:shape="rectangle">
        <size android:height="1dp" />
        <solid android:color="@color/color_border" />
    </shape>
</inset>
