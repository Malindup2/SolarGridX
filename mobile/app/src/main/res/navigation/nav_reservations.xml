<?xml version="1.0" encoding="utf-8"?>
<!-- Reservations, bookings and dashboards (owner: M1). -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reservations_nav"
    app:startDestination="@id/reservationsHomeFragment">

    <!-- Routes to the right home for the signed-in role. -->
    <fragment
        android:id="@+id/reservationsHomeFragment"
        android:name="com.solargridx.mobile.reservations.ReservationsHomeFragment"
        android:label="Reservations"
        tools:layout="@layout/fragment_res_router" />

    <fragment
        android:id="@+id/prosumerHomeFragment"
        android:name="com.solargridx.mobile.reservations.home.ProsumerHomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_prosumer_home">
        <action
            android:id="@+id/action_prosumerHome_to_slotPicker"
            app:destination="@id/slotPickerFragment"
            app:enterAnim="@anim/res_enter"
            app:exitAnim="@anim/res_exit"
            app:popEnterAnim="@anim/res_pop_enter"
            app:popExitAnim="@anim/res_pop_exit" />
        <action
            android:id="@+id/action_prosumerHome_to_myBookings"
            app:destination="@id/myBookingsFragment"
            app:enterAnim="@anim/res_enter"
            app:exitAnim="@anim/res_exit"
            app:popEnterAnim="@anim/res_pop_enter"
            app:popExitAnim="@anim/res_pop_exit" />
        <action
            android:id="@+id/action_prosumerHome_to_bookingDetails"
            app:destination="@id/bookingDetailsFragment"
            app:enterAnim="@anim/res_enter"
            app:exitAnim="@anim/res_exit"
            app:popEnterAnim="@anim/res_pop_enter"
            app:popExitAnim="@anim/res_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/operatorHomeFragment"
        android:name="com.solargridx.mobile.reservations.home.OperatorHomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_operator_home">
        <action
            android:id="@+id/action_operatorHome_to_operatorReview"
            app:destination="@id/operatorReviewFragment"
            app:enterAnim="@anim/res_enter"
            app:exitAnim="@anim/res_exit"
            app:popEnterAnim="@anim/res_pop_enter"
            app:popExitAnim="@anim/res_pop_exit" />
    </fragment>

    <!-- TEMPORARY: stands in for Member 4's slot selection until it is merged. -->
    <fragment
        android:id="@+id/slotPickerFragment"
        android:name="com.solargridx.mobile.reservations.booking.SlotPickerFragment"
        android:label="Choose a slot"
        tools:layout="@layout/fragment_slot_picker">
        <argument
            android:name="pickerMode"
            android:defaultValue="book"
            app:argType="string" />
        <argument
            android:name="reservationId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <!-- The version of the booking being moved, so a change made by someone else is not overwritten. -->
        <argument
            android:name="expectedUpdatedAt"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <!-- M3 → M4 hand-off: opened from a station's details with that station already chosen. -->
        <argument
            android:name="stationId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_slotPicker_to_energyInput"
            app:destination="@id/energyInputFragment"
            app:enterAnim="@anim/res_enter"
            app:exitAnim="@anim/res_exit"
            app:popEnterAnim="@anim/res_pop_enter"
            app:popExitAnim="@anim/res_pop_exit" />
    </fragment>

    <!-- Entry point for M4's hand-off: stationId, slotId, slotDate, startTime, endTime, capacityKwh (Double, see ReservationArgs). -->
    <fragment
        android:id="@+id/energyInputFragment"
        android:name="com.solargridx.mobile.reservations.booking.EnergyInputFragment"
        android:label="Energy"
        tools:layout="@layout/fragment_energy_input">
        <argument android:name="stationId" app:argType="string" />
        <argument
            android:name="stationName"
            android:defaultValue=""
            app:argType="string" />
        <argument android:name="slotId" app:argType="string" />
        <argument android:name="slotDate" app:argType="string" />
        <argument android:name="startTime" app:argType="string" />
        <argument android:name="endTime" app:argType="string" />
        <action
            android:id="@+id/action_energyInput_to_bookingConfirm"
            app:destination="@id/bookingConfirmFragment" />
    </fragment>

    <!-- Review-before-submit, shown as a bottom sheet over energy input. -->
    <dialog
        android:id="@+id/bookingConfirmFragment"
        android:name="com.solargridx.mobile.reservations.booking.BookingConfirmFragment"
        android:label="Confirm"
        tools:layout="@layout/fragment_booking_confirm" />

    <!-- One summary for create / update / reschedule / cancel / approve / reject. -->
    <fragment
        android:id="@+id/bookingSummaryFragment"
        android:name="com.solargridx.mobile.reservations.summary.BookingSummaryFragment"
        android:label="Summary"
        tools:layout="@layout/fragment_booking_summary">
        <argument android:name="summaryAction" app:argType="string" />
        <argument android:name="reservationJson" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/myBookingsFragment"
        android:name="com.solargridx.mobile.reservations.bookings.MyBookingsFragment"
        android:label="My bookings"
        tools:layout="@layout/fragment_my_bookings">
        <action
            android:id="@+id/action_myBookings_to_bookingDetails"
            app:destination="@id/bookingDetailsFragment"
            app:enterAnim="@anim/res_enter"
            app:exitAnim="@anim/res_exit"
            app:popEnterAnim="@anim/res_pop_enter"
            app:popExitAnim="@anim/res_pop_exit" />
        <action
            android:id="@+id/action_myBookings_to_operatorReview"
            app:destination="@id/operatorReviewFragment"
            app:enterAnim="@anim/res_enter"
            app:exitAnim="@anim/res_exit"
            app:popEnterAnim="@anim/res_pop_enter"
            app:popExitAnim="@anim/res_pop_exit" />
        <action
            android:id="@+id/action_myBookings_to_slotPicker"
            app:destination="@id/slotPickerFragment"
            app:enterAnim="@anim/res_enter"
            app:exitAnim="@anim/res_exit"
            app:popEnterAnim="@anim/res_pop_enter"
            app:popExitAnim="@anim/res_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/bookingDetailsFragment"
        android:name="com.solargridx.mobile.reservations.details.BookingDetailsFragment"
        android:label="Booking details"
        tools:layout="@layout/fragment_booking_details">
        <argument android:name="reservationId" app:argType="string" />
        <action
            android:id="@+id/action_bookingDetails_to_slotPicker"
            app:destination="@id/slotPickerFragment"
            app:enterAnim="@anim/res_enter"
            app:exitAnim="@anim/res_exit"
            app:popEnterAnim="@anim/res_pop_enter"
            app:popExitAnim="@anim/res_pop_exit" />
    </fragment>

    <fragment
        android:id="@+id/operatorReviewFragment"
        android:name="com.solargridx.mobile.reservations.details.OperatorReviewFragment"
        android:label="Review"
        tools:layout="@layout/fragment_booking_details">
        <argument android:name="reservationId" app:argType="string" />
    </fragment>
</navigation>
