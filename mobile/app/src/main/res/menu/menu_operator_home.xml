<?xml version="1.0" encoding="utf-8"?>
<!-- Operator home toolbar: open the slot availability screen, refresh the queue. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/actionManageSlots"
        android:icon="@drawable/ic_res_clock"
        android:title="@string/operator_manage_slots"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="always" />
    <item
        android:id="@+id/actionRefresh"
        android:icon="@drawable/ic_res_refresh"
        android:title="@string/res_refresh"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="always" />
</menu>
