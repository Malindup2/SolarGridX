<?xml version="1.0" encoding="utf-8"?>
<!-- One notification: priority dot, message, time. Unread ones are tinted and bold. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.SolarGridX.Res.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/res_space_sm"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/res_card_padding">

        <View
            android:id="@+id/priorityDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_res_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/res_space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notificationMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Body" />

            <TextView
                android:id="@+id/notificationMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
