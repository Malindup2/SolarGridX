<?xml version="1.0" encoding="utf-8"?>
<!-- Review-before-submit bottom sheet: station, icon rows, one primary action, quiet cancel. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/res_space_xxl"
        android:paddingEnd="@dimen/res_space_xxl"
        android:paddingBottom="@dimen/res_space_lg">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/res_confirm_title"
            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/res_space_xs"
            android:gravity="center"
            android:text="@string/res_confirm_subtitle"
            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />

        <!-- Station card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SolarGridX.Res.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/res_space_xl"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/res_space_lg">

                <ImageView
                    android:layout_width="@dimen/res_icon_circle"
                    android:layout_height="@dimen/res_icon_circle"
                    android:background="@drawable/bg_res_circle"
                    android:backgroundTint="@color/status_approved_container"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/res_space_sm"
                    android:src="@drawable/ic_res_bolt"
                    app:tint="@color/color_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/res_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stationName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                    <TextView
                        android:id="@+id/capacityNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/factsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/res_space_sm"
            android:orientation="vertical" />

        <include layout="@layout/view_inline_error" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmButton"
            style="@style/Widget.SolarGridX.Res.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/res_space_xl"
            android:text="@string/res_confirm_book" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/res_space_sm"
            android:indeterminateTint="@color/color_primary"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editButton"
            style="@style/Widget.SolarGridX.Res.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/res_space_xs"
            android:text="@string/btn_cancel" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
