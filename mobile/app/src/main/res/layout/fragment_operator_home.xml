<?xml version="1.0" encoding="utf-8"?>
<!--
  Operator home, in order of use: header (photo, greeting) · search · station hero (awaiting review, approved) ·
  station pills · quick actions · today's numbers · next transfer · pending queue (top 3) · demand and mix charts.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.SolarGridX.Res.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        app:contentInsetEnd="@dimen/res_space_xs"
        app:contentInsetStart="@dimen/res_screen_padding"
        app:menu="@menu/menu_operator_home">

        <include
            layout="@layout/view_home_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical" />
    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/res_screen_padding"
            android:paddingEnd="@dimen/res_screen_padding"
            android:paddingBottom="@dimen/res_screen_padding">


            <include
                android:id="@+id/search"
                layout="@layout/view_search_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_lg" />

            <!-- Hero: the station being run, with today's two key numbers -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_lg"
                app:cardBackgroundColor="@color/color_primary"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/res_space_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_res_circle"
                            android:backgroundTint="@color/res_on_primary_container"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_res_pin"
                            app:tint="?attr/colorOnPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/res_space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/res_your_station"
                                android:textColor="@color/res_on_primary_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/heroStation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/poppins_semibold"
                                android:maxLines="1"
                                android:text="@string/res_value_placeholder"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Two numbers side by side, split by a thin divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/res_space_xl"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/heroPendingBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/heroPending"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/res_value_placeholder"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="32sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/res_stat_awaiting_review"
                                android:textColor="@color/res_on_primary_muted"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/res_space_lg"
                            android:layout_marginEnd="@dimen/res_space_lg"
                            android:background="@color/res_on_primary_container" />

                        <LinearLayout
                            android:id="@+id/heroApprovedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/heroApproved"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/res_value_placeholder"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="32sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/res_stat_approved_upcoming"
                                android:textColor="@color/res_on_primary_muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Station switcher: one tap, no dropdown -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_xl"
                android:text="@string/res_switch_station"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Label" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_xs"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/stationChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <include layout="@layout/view_state" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Quick actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_lg"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quickScan"
                        style="@style/Widget.SolarGridX.Res.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingStart="@dimen/res_space_sm"
                        android:paddingEnd="@dimen/res_space_sm"
                        android:text="@string/res_quick_scan"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_res_qr"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp" />

                    <Space android:layout_width="@dimen/res_space_sm" android:layout_height="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quickSlots"
                        style="@style/Widget.SolarGridX.Res.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingStart="@dimen/res_space_sm"
                        android:paddingEnd="@dimen/res_space_sm"
                        android:text="@string/res_quick_slots"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_res_clock"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp" />

                    <Space android:layout_width="@dimen/res_space_sm" android:layout_height="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quickBookings"
                        style="@style/Widget.SolarGridX.Res.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:paddingStart="@dimen/res_space_sm"
                        android:paddingEnd="@dimen/res_space_sm"
                        android:text="@string/res_quick_bookings"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_res_inbox"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp" />
                </LinearLayout>

                <!-- Today at the station, then the next transfer. Hidden if the extra numbers could not be read. -->
                <LinearLayout
                    android:id="@+id/insightsTop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/todayTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/res_space_xl"
                        android:layout_marginBottom="@dimen/res_space_sm"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include android:id="@+id/statBookings" layout="@layout/view_stat" />

                        <Space android:layout_width="@dimen/res_space_sm" android:layout_height="0dp" />

                        <include android:id="@+id/statCompleted" layout="@layout/view_stat" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/res_space_sm"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include android:id="@+id/statEnergy" layout="@layout/view_stat" />

                        <Space android:layout_width="@dimen/res_space_sm" android:layout_height="0dp" />

                        <include android:id="@+id/statBays" layout="@layout/view_stat" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/nextCard"
                        style="@style/Widget.SolarGridX.Res.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/res_space_lg"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/res_space_xl">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:accessibilityHeading="true"
                                    android:text="@string/res_next_transfer"
                                    android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                                <TextView
                                    android:id="@+id/nextCountdown"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_res_pill"
                                    android:backgroundTint="@color/status_approved_container"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:paddingStart="@dimen/res_space_md"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="@dimen/res_space_md"
                                    android:paddingBottom="2dp"
                                    android:textColor="@color/color_primary_hover"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/nextTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/res_space_md"
                                android:fontFamily="@font/poppins_semibold"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="24sp" />

                            <TextView
                                android:id="@+id/nextWho"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Body" />

                            <TextView
                                android:id="@+id/nextMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />

                            <TextView
                                android:id="@+id/nextEmpty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/res_space_xs"
                                android:text="@string/res_next_none_body"
                                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting"
                                android:visibility="gone" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Pending queue: the top three, with a link to everything -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_xl"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/queueTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/res_pending_queue"
                        android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/queueSeeAll"
                        style="@style/Widget.SolarGridX.Res.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_primary_hover"
                        android:visibility="gone" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/queueList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="@dimen/res_space_sm" />

                <!-- Empty queue / no search results: icon circle, title, help text -->
                <LinearLayout
                    android:id="@+id/queueEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/res_space_lg"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/queueEmptyIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_res_circle"
                        android:backgroundTint="@color/status_approved_container"
                        android:importantForAccessibility="no"
                        android:padding="18dp"
                        android:src="@drawable/ic_res_check"
                        app:tint="@color/color_primary" />

                    <TextView
                        android:id="@+id/queueEmptyTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/res_space_md"
                        android:gravity="center"
                        android:text="@string/res_queue_empty_title"
                        android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                    <TextView
                        android:id="@+id/queueEmptyBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/res_space_xs"
                        android:gravity="center"
                        android:text="@string/res_queue_empty_body"
                        android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearSearch"
                        style="@style/Widget.SolarGridX.Res.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/res_clear_search"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Demand over the next 7 days and the reservation mix -->
                <LinearLayout
                    android:id="@+id/chartsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.SolarGridX.Res.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/res_space_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/res_space_xl">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:accessibilityHeading="true"
                                android:text="@string/res_op_chart_week_title"
                                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                            <TextView
                                android:id="@+id/weekTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />

                            <com.solargridx.mobile.reservations.ui.charts.BarChartView
                                android:id="@+id/weekChart"
                                android:layout_width="match_parent"
                                android:layout_height="170dp"
                                android:layout_marginTop="@dimen/res_space_lg" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.SolarGridX.Res.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/res_space_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/res_space_xl">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:accessibilityHeading="true"
                                android:text="@string/res_op_chart_status_title"
                                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/res_space_lg"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.solargridx.mobile.reservations.ui.charts.DonutChartView
                                    android:id="@+id/statusDonut"
                                    android:layout_width="132dp"
                                    android:layout_height="132dp" />

                                <LinearLayout
                                    android:id="@+id/statusLegend"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/res_space_xl"
                                    android:layout_weight="1"
                                    android:orientation="vertical" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
