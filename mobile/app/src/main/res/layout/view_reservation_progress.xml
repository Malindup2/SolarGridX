<?xml version="1.0" encoding="utf-8"?>
<!-- Reservation progress card: title + stage badge, progress bar, then the stepper rows.
     Filled by ReservationProgress.bind(); colours are set at runtime from StatusStyle tokens. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.SolarGridX.Res.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/res_space_md">

        <LinearLayout
            android:id="@+id/progressHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/res_progress_title"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

            <TextView
                android:id="@+id/progressBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_res_pill"
                android:paddingStart="@dimen/res_space_md"
                android:paddingTop="@dimen/res_space_xs"
                android:paddingEnd="@dimen/res_space_md"
                android:paddingBottom="@dimen/res_space_xs"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/res_space_md"
            android:max="100"
            app:trackCornerRadius="4dp"
            app:trackThickness="8dp" />

        <LinearLayout
            android:id="@+id/progressSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/res_space_md"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
