<?xml version="1.0" encoding="utf-8"?>
<!-- Profile tab: green account card, details, actions, danger zone (reference: Account / Settings). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/res_screen_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/res_space_lg"
            android:accessibilityHeading="true"
            android:text="@string/profile_title"
            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Display" />

        <!-- Account card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/res_space_lg"
            app:cardBackgroundColor="@color/color_primary"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/res_space_xl">

                <!-- Initials, covered by the photo once one is uploaded. Tap to change the photo. -->
                <FrameLayout
                    android:id="@+id/avatarFrame"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/avatar_change"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_res_circle"
                        android:backgroundTint="?attr/colorOnPrimary"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/color_primary_hover"
                        android:textSize="22sp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/avatar_cd"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.SolarGridX.Circle" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/res_space_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semibold"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/profileSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_regular"
                        android:maxLines="1"
                        android:textColor="@color/res_on_primary_muted"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/res_space_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/profileStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_res_pill"
                            android:backgroundTint="@color/res_on_primary_container"
                            android:fontFamily="@font/poppins_semibold"
                            android:paddingStart="@dimen/res_space_md"
                            android:paddingTop="2dp"
                            android:paddingEnd="@dimen/res_space_md"
                            android:paddingBottom="2dp"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/profileSince"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/res_space_sm"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/res_on_primary_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <include layout="@layout/view_state" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_xl"
                android:layout_marginBottom="@dimen/res_space_sm"
                android:text="@string/profile_account_details"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Label" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SolarGridX.Res.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/detailRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/res_divider_horizontal"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SolarGridX.Res.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_lg">

                <LinearLayout
                    android:id="@+id/actionRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/res_divider_horizontal"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/dangerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_xl"
                android:layout_marginBottom="@dimen/res_space_sm"
                android:text="@string/profile_danger_zone"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Label" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dangerCard"
                style="@style/Widget.SolarGridX.Res.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/dangerRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
