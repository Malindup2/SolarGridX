<?xml version="1.0" encoding="utf-8"?>
<!--
  Prosumer home, in sections (reference: solar dashboards):
  hero (next booking + upcoming-kWh ring) · quick actions · counts ·
  energy this week (bars) · booking status (donut) · recent bookings.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.SolarGridX.Res.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/menu_res_refresh" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/res_screen_padding"
            android:paddingEnd="@dimen/res_screen_padding"
            android:paddingBottom="@dimen/res_screen_padding">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Display" />

            <TextView
                android:id="@+id/today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />

            <!-- Pending account banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pendingBanner"
                style="@style/Widget.SolarGridX.Res.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_lg"
                android:visibility="gone"
                app:cardBackgroundColor="@color/status_pending_container"
                app:cardElevation="0dp"
                app:strokeColor="@color/status_pending">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/res_space_lg">

                    <ImageView
                        android:layout_width="@dimen/res_icon_md"
                        android:layout_height="@dimen/res_icon_md"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_res_hourglass"
                        app:tint="@color/status_pending" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/res_space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/res_pending_account_title"
                            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/res_space_xs"
                            android:text="@string/res_pending_account_body"
                            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include layout="@layout/view_state" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 1. Hero: next booking (left) + upcoming energy ring (right) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_lg"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/color_primary"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/res_space_xl">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/heroLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_medium"
                                android:textColor="@color/res_on_primary_muted"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/heroTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/res_space_xs"
                                android:fontFamily="@font/poppins_semibold"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="24sp" />

                            <TextView
                                android:id="@+id/heroBody"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="@color/res_on_primary_muted"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/heroStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/res_space_sm"
                                android:background="@drawable/bg_res_pill"
                                android:backgroundTint="@color/res_on_primary_container"
                                android:fontFamily="@font/poppins_semibold"
                                android:paddingStart="@dimen/res_space_md"
                                android:paddingTop="2dp"
                                android:paddingEnd="@dimen/res_space_md"
                                android:paddingBottom="2dp"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/heroAction"
                                style="@style/Widget.SolarGridX.Res.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/res_space_md"
                                android:minHeight="44dp"
                                android:paddingStart="@dimen/res_space_lg"
                                android:paddingEnd="@dimen/res_space_md"
                                android:textColor="@color/color_primary_hover"
                                android:textSize="14sp"
                                app:backgroundTint="?attr/colorOnPrimary"
                                app:icon="@drawable/ic_res_chevron_right"
                                app:iconGravity="end"
                                app:iconTint="@color/color_primary_hover" />
                        </LinearLayout>

                        <com.solargridx.mobile.reservations.ui.charts.DonutChartView
                            android:id="@+id/heroRing"
                            android:layout_width="112dp"
                            android:layout_height="112dp"
                            android:layout_marginStart="@dimen/res_space_md" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Counts -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_xl"
                    android:layout_marginBottom="@dimen/res_space_sm"
                    android:accessibilityHeading="true"
                    android:text="@string/res_overview"
                    android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingBottom="@dimen/res_space_sm">

                    <include android:id="@+id/statActive" layout="@layout/view_stat" />

                    <Space android:layout_width="@dimen/res_space_sm" android:layout_height="0dp" />

                    <include android:id="@+id/statPending" layout="@layout/view_stat" />

                    <Space android:layout_width="@dimen/res_space_sm" android:layout_height="0dp" />

                    <include android:id="@+id/statUpcoming" layout="@layout/view_stat" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bookButton"
                    style="@style/Widget.SolarGridX.Res.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_lg"
                    android:text="@string/res_book_energy"
                    app:icon="@drawable/ic_res_bolt"
                    app:iconGravity="textStart"
                    app:iconTint="?attr/colorOnPrimary" />

                <!-- 4. Energy this week -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SolarGridX.Res.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/res_space_xl">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/res_chart_week_title"
                            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                        <TextView
                            android:id="@+id/weekTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />

                        <com.solargridx.mobile.reservations.ui.charts.BarChartView
                            android:id="@+id/weekChart"
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:layout_marginTop="@dimen/res_space_lg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Booking status breakdown -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SolarGridX.Res.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/res_space_xl">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/res_chart_status_title"
                            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/res_space_lg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.solargridx.mobile.reservations.ui.charts.DonutChartView
                                android:id="@+id/statusDonut"
                                android:layout_width="132dp"
                                android:layout_height="132dp" />

                            <LinearLayout
                                android:id="@+id/statusLegend"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/res_space_xl"
                                android:layout_weight="1"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 6. Recent bookings -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_xl"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/res_recent_title"
                        android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/seeAll"
                        style="@style/Widget.SolarGridX.Res.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/res_see_all"
                        android:textColor="@color/color_primary_hover" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/recentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_xs"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/res_space_sm" />

                <TextView
                    android:id="@+id/recentEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/res_no_upcoming"
                    android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
