<?xml version="1.0" encoding="utf-8"?>
<!-- Booking details for every status. Also used for the operator's review (different actions). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.SolarGridX.Res.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/res_screen_padding">

            <include layout="@layout/view_state" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/headline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.SolarGridX.Res.Title" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/statusChip"
                        style="@style/Widget.SolarGridX.Res.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_xs"
                    android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />

                <!-- Key numbers at a glance, split by thin dividers -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SolarGridX.Res.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:divider="@drawable/res_divider_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/res_space_lg"
                        android:paddingBottom="@dimen/res_space_lg"
                        android:showDividers="middle">

                        <include android:id="@+id/stripEnergy" layout="@layout/item_strip_value" />
                        <include android:id="@+id/stripSlot" layout="@layout/item_strip_value" />
                        <include android:id="@+id/stripDate" layout="@layout/item_strip_value" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Completed: transfer completion view -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/completedCard"
                    style="@style/Widget.SolarGridX.Res.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_lg"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/status_completed_container"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/status_completed">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/res_space_lg">

                        <ImageView
                            android:layout_width="@dimen/res_icon_md"
                            android:layout_height="@dimen/res_icon_md"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_res_bolt"
                            app:tint="@color/status_completed" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/res_space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/res_completed_title"
                                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                            <TextView
                                android:id="@+id/completedBody"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/res_space_xs"
                                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Rejected: reason -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/rejectedCard"
                    style="@style/Widget.SolarGridX.Res.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_lg"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/status_rejected_container"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/status_rejected">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/res_space_lg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/res_rejection_reason"
                            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Label" />

                        <TextView
                            android:id="@+id/rejectedReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/res_space_xs"
                            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Body" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SolarGridX.Res.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_lg">

                    <LinearLayout
                        android:id="@+id/factsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/res_card_padding"
                        android:paddingTop="@dimen/res_space_md"
                        android:paddingEnd="@dimen/res_card_padding"
                        android:paddingBottom="@dimen/res_space_md" />
                </com.google.android.material.card.MaterialCardView>

                <include layout="@layout/view_inline_error" />

                <ProgressBar
                    android:id="@+id/actionProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/res_space_md"
                    android:indeterminateTint="@color/color_primary"
                    android:visibility="gone" />

                <!-- Actions (each shown only where it applies) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/primaryAction"
                    style="@style/Widget.SolarGridX.Res.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_xl"
                    android:visibility="gone"
                    app:iconGravity="textStart"
                    app:iconTint="?attr/colorOnPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/secondaryAction"
                    style="@style/Widget.SolarGridX.Res.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_md"
                    android:visibility="gone"
                    app:iconGravity="textStart"
                    app:iconTint="?attr/colorOnSurface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dangerAction"
                    style="@style/Widget.SolarGridX.Res.Button.Text.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_md"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
