<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.SolarGridX.Res.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/res_screen_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/res_energy_title"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_xs"
                android:text="@string/res_energy_subtitle"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SolarGridX.Res.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_xl">

                <LinearLayout
                    android:id="@+id/factsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/res_card_padding"
                    android:paddingTop="@dimen/res_space_md"
                    android:paddingEnd="@dimen/res_card_padding"
                    android:paddingBottom="@dimen/res_space_md" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/energyLayout"
                style="@style/Widget.SolarGridX.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_xl"
                android:hint="@string/res_energy_hint"
                app:expandedHintEnabled="false"
                app:helperTextEnabled="true"
                app:placeholderText="0"
                app:startIconDrawable="@drawable/ic_res_bolt"
                app:suffixText="kWh">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/energyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:fontFamily="@font/poppins_semibold"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/quickPickLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_lg"
                android:text="@string/res_quick_pick"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/quickPicks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_xs"
                app:singleSelection="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/continueButton"
                style="@style/Widget.SolarGridX.Res.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/res_space_xxl"
                android:text="@string/res_review_booking" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
