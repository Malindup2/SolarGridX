<?xml version="1.0" encoding="utf-8"?>
<!-- Settings-style row (reference: Settings / Account): icon, label, optional value, chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/res_space_lg"
    android:paddingTop="@dimen/res_space_md"
    android:paddingEnd="@dimen/res_space_md"
    android:paddingBottom="@dimen/res_space_md">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_res_circle"
        android:backgroundTint="@color/status_approved_container"
        android:importantForAccessibility="no"
        android:padding="8dp"
        app:tint="@color/color_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/res_space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Body" />

        <TextView
            android:id="@+id/rowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="@dimen/res_icon_md"
        android:layout_height="@dimen/res_icon_md"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_res_chevron_right"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
