<?xml version="1.0" encoding="utf-8"?>
<!-- Prosumer's transfer QR for an Approved booking, with its state (valid / expired / used). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.SolarGridX.Res.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/res_screen_padding">

            <include layout="@layout/view_state" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/qrHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                <TextView
                    android:id="@+id/qrSlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_xs"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SolarGridX.Res.Card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_xl">

                    <ImageView
                        android:id="@+id/qrImage"
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:background="@android:color/white"
                        android:contentDescription="@string/qr_cd"
                        android:padding="@dimen/res_space_md"
                        android:scaleType="fitCenter" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/qrState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_lg"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.SolarGridX.Res.Label" />

                <TextView
                    android:id="@+id/qrInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_sm"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.SolarGridX.Res.Body" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/res_space_xl"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copyButton"
                        style="@style/Widget.SolarGridX.Res.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/res_button_height"
                        android:layout_marginEnd="@dimen/res_space_sm"
                        android:text="@string/qr_copy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/refreshButton"
                        style="@style/Widget.SolarGridX.Res.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/res_button_height"
                        android:text="@string/qr_refresh" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
