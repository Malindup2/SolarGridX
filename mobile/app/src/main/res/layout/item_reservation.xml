<?xml version="1.0" encoding="utf-8"?>
<!-- One reservation card (my bookings, operator queue): status pill, icon circle, title, time, energy. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.SolarGridX.Res.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/res_space_md"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/res_space_lg">

        <com.google.android.material.chip.Chip
            android:id="@+id/itemStatus"
            style="@style/Widget.SolarGridX.Res.StatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/res_space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/itemIcon"
                android:layout_width="@dimen/res_icon_circle"
                android:layout_height="@dimen/res_icon_circle"
                android:background="@drawable/bg_res_circle"
                android:backgroundTint="@color/status_approved_container"
                android:importantForAccessibility="no"
                android:padding="@dimen/res_space_sm"
                android:src="@drawable/ic_res_bolt"
                app:tint="@color/color_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/res_space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/itemTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />

                <TextView
                    android:id="@+id/itemWhen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SolarGridX.Res.Supporting" />
            </LinearLayout>

            <TextView
                android:id="@+id/itemMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/res_space_sm"
                android:textAppearance="@style/TextAppearance.SolarGridX.Res.Section" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
