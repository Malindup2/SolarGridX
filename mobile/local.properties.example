sdk.dir=/path/to/your/Android/Sdk
# USB phone: run "adb reverse tcp:5187 tcp:5187". Emulator without adb reverse: use http://10.0.2.2:5187/api/
API_BASE_URL=http://localhost:5187/api/

# Optional. With a key the Stations tab shows a map; without one it shows a list.
# MAPS_API_KEY=your-google-maps-api-key
